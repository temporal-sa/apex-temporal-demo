# Copy to .env and fill in. .env is gitignored.

# Temporal (defaults match docker-compose.yml)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE_NONPROD=nonprod-provisioning

# Default deploy target for the worker and CLIs (each also takes --target):
#   aws  real Terraform against real AWS (needs the state bucket below)
#   local real Terraform against Floci (docker compose --profile local up -d floci)
#   sim  simulated, no Terraform or AWS; runs on task queue <queue>-sim
APEX_TARGET=aws

# Local target (Floci). Defaults shown; the state bucket is created for you.
# FLOCI_ENDPOINT=http://localhost:4566
# LOCAL_STATE_BUCKET=apex-local-state

# Terraform remote state: an existing S3 bucket you can read and write.
# No DynamoDB lock table: the modules use S3 native locking (use_lockfile),
# which needs Terraform 1.10+.
TF_STATE_BUCKET=
TF_STATE_REGION=us-east-1

# Optional: Grafana Cloud metrics (only for `docker compose --profile metrics`)
GRAFANA_PROM_REMOTE_WRITE_URL=
GRAFANA_PROM_USERNAME=
GRAFANA_PROM_API_KEY=
